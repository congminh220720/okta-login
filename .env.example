# Hostname only, without https:// or a trailing slash.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Regular Web Application: both DB connections enabled, Password + Password Realm grants.
# For "Sign in with Auth0": Allowed Callback URLs = APP_ORIGIN/auth/callback,
# Allowed Logout URLs = APP_ORIGIN, Authorization Code grant enabled.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# M2M application authorized for Management API: read:users AND create:users.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

AUTH0_DEV_CONNECTION=devdb
AUTH0_ECOM_CONNECTION=ecomdb
# Both connections must allow username signup/login WITHOUT requiring email.
# The public signup page allows either DB for lab use only; see README before deployment.

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Must match the browser origin exactly; use HTTPS outside local development.
APP_ORIGIN=http://localhost:3000

# Optional: origins allowed to call /api/auth/resolve-connection from the Auth0-hosted
# login page (hosted-pages/). Defaults to https://<AUTH0_DOMAIN>. Add your custom domain if used.
# AUTH0_LOGIN_PAGE_ORIGINS=https://your-tenant.us.auth0.com,https://login.example.com
